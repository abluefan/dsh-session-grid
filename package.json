{
  "name": "dsh-session-grid",
  "version": "0.0.1",
  "description": "多會話同屏網格（PoC）：喺一個 main 頁面入面用 n 個 pane 同時渲染 n 條獨立 session 嘅對話。",
  "private": true,
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "main": "./index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT"
}
